# Server
NODE_ENV=development
PORT=3000
# En producción el default es 127.0.0.1 (solo cloudflared). 0.0.0.0 para jugar en LAN.
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://labase:labase_dev@localhost:5432/labase

# JWT Secret — obligatorio en producción (>= 32 caracteres).
# Generar con: openssl rand -base64 48
JWT_SECRET=

# Orígenes del cliente permitidos (separados por coma) — obligatorio en producción
CORS_ORIGINS=https://labase.frogbit.com.ar

# Proxies de confianza para X-Forwarded-* (default: loopback, cloudflared local)
# TRUST_PROXY=loopback

# LiveKit (optional, for video/audio)
LIVEKIT_URL=http://localhost:7880
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

# Frontend
VITE_API_URL=http://localhost:3000
